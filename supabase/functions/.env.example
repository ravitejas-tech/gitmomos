# Edge function secrets. Locally: copy to supabase/functions/.env
# Production: npx supabase secrets set --env-file supabase/functions/.env

# Gemini: each user saves their own API key in Settings. These only put a model
# ahead of the built-in fallback chain for reports and for the profile chatbot.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL: <your site>/dashboard/connections/github
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Shared secret between pg_cron and the `sync` function. Generate with: openssl rand -hex 32
# Must match the `worker_secret` Vault secret (see README).
WORKER_SECRET=your_random_worker_secret

# Local development only: lets you connect a Gitea running on localhost / http.
# ALLOW_LOCAL_GITEA=true
